    local function selectTab(name)
        if not tabs[name] then return end
        for n, btn in pairs(tabButtons) do
            if n == name then
                btn.bg.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
                btn.accent.Visible = true
                btn.label.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                btn.bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                btn.accent.Visible = false
                btn.label.TextColor3 = Color3.fromRGB(150, 150, 160)
            end
        end
        for _, frame in pairs(tabs) do frame.Visible = false end
        tabs[name].Visible = true
        currentTab = name
    end

