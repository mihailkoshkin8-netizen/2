    createToggle(miscScroll, "Bhop / Strafe", false, function(v)
        if v then
            inputBegan = UserInputService.InputBegan:Connect(function(input, gp)
                if gp then return end
                local kc = input.KeyCode
                if kc == Enum.KeyCode.W then moveKeys.W = true
                elseif kc == Enum.KeyCode.A then moveKeys.A = true
                elseif kc == Enum.KeyCode.S then moveKeys.S = true
                elseif kc == Enum.KeyCode.D then moveKeys.D = true
                elseif kc == Enum.KeyCode.Space then moveKeys.Space = true end
            end)
            inputEnded = UserInputService.InputEnded:Connect(function(input)
                local kc = input.KeyCode
                if kc == Enum.KeyCode.W then moveKeys.W = false
                elseif kc == Enum.KeyCode.A then moveKeys.A = false
                elseif kc == Enum.KeyCode.S then moveKeys.S = false
                elseif kc == Enum.KeyCode.D then moveKeys.D = false
                elseif kc == Enum.KeyCode.Space then moveKeys.Space = false end
            end)

            local lastBhop = 0
            bhopConn = RunService.Heartbeat:Connect(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hrp or not hum or hum.Health <= 0 then return end
                local cam = workspace.CurrentCamera
                if not cam then return end

                local dir = Vector3.new(0, 0, 0)
                local cf = cam.CFrame
                if moveKeys.W then dir = dir + cf.LookVector end
                if moveKeys.S then dir = dir - cf.LookVector end
                if moveKeys.A then dir = dir - cf.RightVector end
                if moveKeys.D then dir = dir + cf.RightVector end

                local inAir = hum:GetState() == Enum.HumanoidStateType.Jumping
                           or hum:GetState() == Enum.HumanoidStateType.Freefall
                local grounded = hum.FloorMaterial ~= Enum.Material.Air

                if dir.Magnitude > 0 then
                    dir = Vector3.new(dir.X, 0, dir.Z).Unit
                    local speed = STRAFE_SPEED * (inAir and AIR_MULTIPLIER or 1)
                    local v2 = dir * speed
                    hrp.Velocity = Vector3.new(v2.X, hrp.Velocity.Y, v2.Z)
                end

                local now = tick()
                if moveKeys.Space and grounded and (now - lastBhop) > BHOP_COOLDOWN then
                    hrp.Velocity = Vector3.new(hrp.Velocity.X, BHOP_POWER, hrp.Velocity.Z)
                    lastBhop = now
                end
            end)
            track(bhopConn); track(inputBegan); track(inputEnded)
            onCleanup(cleanupBhop)
        else
            cleanupBhop()
        end
    end, 2)

