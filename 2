local function getGuiParent()
    if CAPS.gethui then
        local ok, p = pcall(gethui)
        if ok and p then return p end
    end
    if CAPS.cloneref then
        local ok, p = pcall(cloneref, game:GetService("CoreGui"))
        if ok and p then return p end
    end
    if CAPS.coregui then return game:GetService("CoreGui") end
    return PlayerGui
end
local GuiParent = getGuiParent()

local function isLocked(requires)
    if not requires or #requires == 0 then return false, {} end
    local missing = {}
    for _, req in ipairs(requires) do
        if not CAPS[req] then table.insert(missing, req) end
    end
    return #missing > 0, missing
end

