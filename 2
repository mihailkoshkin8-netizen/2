    local function installSilentAimHook()
        if not CAPS.hookmetamethod or not CAPS.getnamecallmethod then return false end
        local wrap = CAPS.newcclosure and newcclosure or function(f) return f end
        local okHook = pcall(function()
            oldNamecall = hookmetamethod(game, "__namecall", wrap(function(self, ...)
                local method = getnamecallmethod()
                if not silentAimEnabled or not silentAimTarget then
                    return oldNamecall(self, ...)
                end
                if method ~= "FireServer" and method ~= "InvokeServer" then
                    return oldNamecall(self, ...)
                end
                local char = silentAimTarget.Character
                local head = char and char:FindFirstChild("Head")
                local cam = workspace.CurrentCamera
                if not (head and cam) then
                    return oldNamecall(self, ...)
                end
                local camPos = cam.CFrame.Position
                local args = table.pack(...)
                local modified = false
                for i = 1, args.n do
                    local a = args[i]
                    local t = typeof(a)
                    if t == "Vector3" and (a - camPos).Magnitude < 5 then
                        args[i] = head.Position
                        modified = true
                    elseif t == "CFrame" and (a.Position - camPos).Magnitude < 5 then
                        args[i] = CFrame.new(a.Position, head.Position)
                        modified = true
                    end
                end
                if modified then
                    return oldNamecall(self, table.unpack(args, 1, args.n))
                end
                return oldNamecall(self, ...)
            end))
        end)
        return okHook and oldNamecall ~= nil
    end

    local function restoreSilentAimHook()
        if not oldNamecall then return end
        if CAPS.restorefunction then
            pcall(restorefunction, oldNamecall)
        elseif CAPS.hookmetamethod then
            pcall(function() hookmetamethod(game, "__namecall", oldNamecall) end)
        end
        oldNamecall = nil
    end

