        for _, fn in ipairs(State.cleanupExtras) do pcall(fn) end
        State.cleanupExtras = {}
    end
    if State.introGui then pcall(function() State.introGui:Destroy() end) end
    if State.mainGui  then pcall(function() State.mainGui:Destroy() end)  end
    getgenv().__KotostHub = nil
end
